{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "GOC",
  "scopeName": "source.goc",
  "fileTypes": ["goc", "goh"],
  "patterns": [
    { "include": "source.c" }
  ],
  "injections": {
    "L:source.goc -comment -string": {
      "comment": "Goc-spezifische Erweiterungen werden als Injection auf JEDER Verschachtelungsebene angewendet (nicht nur auf Dateiebene), damit z.B. 'word' oder 'MSG_*' auch innerhalb von Funktions-/Methodenkoerpern erkannt werden. 'L:' = niedrige Prioritaet (greift nur, wo die C-Grammatik noch keinen Token vergeben hat); '-comment -string' verhindert False-Positives in Kommentaren/String-Literalen.",
      "patterns": [
        { "include": "#goc-object-block" },
        { "include": "#goc-include" },
        { "include": "#goc-keywords" },
        { "include": "#geos-messages" },
        { "include": "#geos-types" }
      ]
    }
  },
  "repository": {

    "goc-object-block": {
      "comment": "Deklaration von GOC-Klassen-/Objektblöcken, z.B. '@class MyClass, SuperClass;' oder '@object MyClass MyObject = { ... }'",
      "begin": "(@class|@classdecl|@object)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.control.directive.goc" },
        "2": { "name": "entity.name.class.goc" }
      },
      "end": "(?=[{;=])",
      "patterns": [
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\b",
          "name": "entity.other.inherited-class.goc"
        },
        { "include": "source.c#comments" }
      ]
    },

    "goc-include": {
      "comment": "@include <fname> / @include \"fname\" - analog zu #include, aber Goc-spezifisch (siehe @include-Direktive).",
      "name": "meta.preprocessor.include.goc",
      "begin": "(@include)\\b",
      "beginCaptures": { "1": { "name": "keyword.control.directive.goc" } },
      "end": "(?=[\\r\\n;])",
      "patterns": [
        { "name": "string.quoted.other.lt-gt.include.goc", "match": "<[^>]+>" },
        { "name": "string.quoted.double.goc", "match": "\"[^\"]*\"" }
      ]
    },

    "goc-keywords": {
      "comment": "Vollständige Liste der Goc-Präprozessor-/Sprachdirektiven (siehe data/goc-keywords.json fuer Beschreibungen). '@include' wird separat via #goc-include behandelt.",
      "patterns": [
        {
          "name": "keyword.control.directive.goc",
          "match": "@(reserveMessages|exportMessages|kbdAccelerator|importMessage|dispatchcall|elementArray|vardataAlias|genChildren|visChildren|chunkArray|protominor|specificUI|visMoniker|callsuper|classdecl|composite|genParent|prototype|visParent|dispatch|instance|optimize|default|gstring|message|noreloc|vardata|define|deflib|endlib|extern|header|ifndef|method|object|record|alias|chunk|class|endif|ifdef|reloc|stack|start|call|endc|link|send|uses|end|if)\\b"
        },
        {
          "comment": "gcnList und _reloc sind laut Doku bewusst OHNE @-Präfix.",
          "name": "keyword.control.directive.goc",
          "match": "\\b(gcnList|_reloc)\\b"
        },
        {
          "comment": "@call-Flags",
          "name": "support.constant.goc",
          "match": "\\b(forceQueue|checkDuplicate|checkLastOnly|insertAtFront|canDiscardIfDesperate|notDetachable)\\b"
        }
      ]
    },

    "geos-messages": {
      "patterns": [
        {
          "name": "constant.other.message.goc",
          "match": "\\b(MSG|C_MSG)_[A-Za-z0-9_]+\\b"
        },
        {
          "name": "constant.other.attribute.goc",
          "match": "\\b(ATTR|GI|VUI)_[A-Za-z0-9_]+\\b"
        }
      ]
    },

    "geos-types": {
      "comment": "Übliche GEOS-/Watcom-16-Bit-Typen. Bei Bedarf erweitern (bitte mit Beleg aus SDK-Doku, keine Vermutungen).",
      "patterns": [
        {
          "name": "storage.type.geos.goc",
          "match": "\\b(word|dword|sword|sbyte|byte|fixed_t|fptr|lptr|optr|vmptr|Handle|MemHandle|FileHandle|GStateHandle|Boolean|TCHAR|ChunkHandle|LMemHandle|OptrType|WWFixedAsDWord|WBFixed)\\b"
        }
      ]
    }
  }
}
